import { Component, inject, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatIconModule } from '@angular/material/icon';
import { MatButtonModule } from '@angular/material/button';
import { NotificationStore } from '../../stores/notification/notification.store';

/**
 * Toast Notification Component
 *
 * Displays toast notifications in the top-right corner of the screen.
 * Supports multiple notification types: success, error, warning, info.
 * Auto-dismisses based on duration or manual close.
 *
 * Usage: Add to app.component.html
 * <app-toast-notification></app-toast-notification>
 */
@Component({
  selector: 'app-toast-notification',
  standalone: true,
  imports: [CommonModule, MatIconModule, MatButtonModule],
  template: `
    <div class="toast-container">
      @for (toast of toasts(); track toast.id) {
      <div class="toast toast-{{ toast.type }}" (click)="closeToast(toast.id)">
        <div class="toast-content">
          <mat-icon class="toast-icon">{{ getIcon(toast.type) }}</mat-icon>
          <span class="toast-message">{{ toast.message }}</span>
        </div>
        <button
          mat-icon-button
          class="toast-close"
          (click)="closeToast(toast.id); $event.stopPropagation()"
          aria-label="Close notification"
        >
          <mat-icon>close</mat-icon>
        </button>
      </div>
      }
    </div>
  `,
  styles: [
    `
      @import '../../styles/variables';
      @import '../../styles/mixins';

      .toast-container {
        position: fixed;
        top: $spacing-lg;
        right: $spacing-lg;
        z-index: $z-index-toast;
        display: flex;
        flex-direction: column;
        gap: $spacing-sm;
        max-width: 400px;
        pointer-events: none;

        @include responsive(mobile) {
          left: $spacing-md;
          right: $spacing-md;
          max-width: none;
        }
      }

      .toast {
        @include flex-row-between;
        align-items: flex-start;
        gap: $spacing-sm;
        padding: $spacing-md;
        background: white;
        border-radius: $border-radius-md;
        box-shadow: $shadow-lg;
        border-left: 4px solid;
        cursor: pointer;
        pointer-events: auto;
        min-height: 60px;
        transition: all $transition-base;

        &:hover {
          transform: translateX(-4px);
          box-shadow: $shadow-xl;
        }

        &.toast-success {
          border-left-color: $success-500;

          .toast-icon {
            color: $success-500;
          }
        }

        &.toast-error {
          border-left-color: $error-500;

          .toast-icon {
            color: $error-500;
          }
        }

        &.toast-warning {
          border-left-color: $warning-500;

          .toast-icon {
            color: $warning-500;
          }
        }

        &.toast-info {
          border-left-color: $info-500;

          .toast-icon {
            color: $info-500;
          }
        }
      }

      .toast-content {
        @include flex-row;
        align-items: flex-start;
        gap: $spacing-sm;
        flex: 1;
      }

      .toast-icon {
        font-size: 24px;
        width: 24px;
        height: 24px;
        flex-shrink: 0;
      }

      .toast-message {
        flex: 1;
        font-size: $font-size-sm;
        color: $text-primary;
        line-height: 1.5;
        word-break: break-word;
      }

      .toast-close {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        margin: -4px -4px 0 0;

        mat-icon {
          font-size: 20px;
          width: 20px;
          height: 20px;
        }
      }
    `,
  ],
})
export class ToastNotificationComponent {
  private notificationStore = inject(NotificationStore);

  // Expose toasts from store
  protected toasts = this.notificationStore.toasts$;

  /**
   * Close a toast notification
   */
  protected closeToast(id: string): void {
    this.notificationStore.removeToast(id);
  }

  /**
   * Get icon for toast type
   */
  protected getIcon(type: string): string {
    switch (type) {
      case 'success':
        return 'check_circle';
      case 'error':
        return 'error';
      case 'warning':
        return 'warning';
      case 'info':
        return 'info';
      default:
        return 'notifications';
    }
  }
}
