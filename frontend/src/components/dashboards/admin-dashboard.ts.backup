import { Component, inject, OnInit, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatCardModule } from '@angular/material/card';
import { MatIconModule } from '@angular/material/icon';
import { MatButtonModule } from '@angular/material/button';
import { MatTableModule } from '@angular/material/table';
import { MatChipsModule } from '@angular/material/chips';
import { Router } from '@angular/router';
import { AdminDashboardResponse } from '../../models/dashboard.model';
import { ROUTES } from '../../constants/routes';

/**
 * Admin Dashboard Component
 *
 * System administrator dashboard with platform-wide statistics and management tools.
 * Provides overview of all organisations, users, and system activity.
 */
@Component({
  selector: 'app-admin-dashboard',
  standalone: true,
  imports: [
    CommonModule,
    MatCardModule,
    MatIconModule,
    MatButtonModule,
    MatTableModule,
    MatChipsModule,
  ],
  template: `
    <div class="dashboard-container">
      <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>System-wide overview and management</p>
      </div>

      <!-- Stats Cards -->
      <div class="stats-grid">
        <mat-card class="stat-card primary">
          <mat-card-content>
            <div class="stat-icon">
              <mat-icon>business</mat-icon>
            </div>
            <div class="stat-details">
              <div class="stat-value">{{ stats().totalOrganisations }}</div>
              <div class="stat-label">Total Organisations</div>
            </div>
          </mat-card-content>
        </mat-card>

        <mat-card class="stat-card success">
          <mat-card-content>
            <div class="stat-icon">
              <mat-icon>people</mat-icon>
            </div>
            <div class="stat-details">
              <div class="stat-value">{{ stats().totalUsers }}</div>
              <div class="stat-label">Total Users</div>
            </div>
          </mat-card-content>
        </mat-card>

        <mat-card class="stat-card warning">
          <mat-card-content>
            <div class="stat-icon">
              <mat-icon>event</mat-icon>
            </div>
            <div class="stat-details">
              <div class="stat-value">{{ stats().activeInterviews }}</div>
              <div class="stat-label">Active Interviews</div>
            </div>
          </mat-card-content>
        </mat-card>

        <mat-card class="stat-card info">
          <mat-card-content>
            <div class="stat-icon">
              <mat-icon>check_circle</mat-icon>
            </div>
            <div class="stat-details">
              <div class="stat-value">{{ stats().verifiedOrganisations }}</div>
              <div class="stat-label">Verified Organisations</div>
            </div>
          </mat-card-content>
        </mat-card>
      </div>

      <!-- Quick Actions -->
      <mat-card class="quick-actions-card">
        <mat-card-header>
          <mat-card-title>Quick Actions</mat-card-title>
        </mat-card-header>
        <mat-card-content>
          <div class="actions-grid">
            <button
              mat-raised-button
              color="primary"
              (click)="navigateTo(ROUTES.ADMIN.ORGANISATIONS)"
            >
              <mat-icon>business</mat-icon>
              Manage Organisations
            </button>
            <button mat-raised-button color="primary" (click)="navigateTo(ROUTES.ADMIN.USERS)">
              <mat-icon>people</mat-icon>
              Manage Users
            </button>
            <button mat-raised-button color="primary" (click)="navigateTo(ROUTES.ADMIN.ANALYTICS)">
              <mat-icon>analytics</mat-icon>
              View Analytics
            </button>
          </div>
        </mat-card-content>
      </mat-card>

      <!-- Recent Activity -->
      <div class="dashboard-grid">
        <mat-card class="recent-activity-card">
          <mat-card-header>
            <mat-card-title>Recent Organisation Registrations</mat-card-title>
          </mat-card-header>
          <mat-card-content>
            @if (recentOrganisations().length > 0) {
            <div class="activity-list">
              @for (org of recentOrganisations(); track org.id) {
              <div class="activity-item">
                <div class="activity-icon">
                  <mat-icon>business</mat-icon>
                </div>
                <div class="activity-details">
                  <div class="activity-title">{{ org.name }}</div>
                  <div class="activity-subtitle">{{ org.email }}</div>
                </div>
                <mat-chip [color]="org.verified ? 'primary' : 'warn'">
                  {{ org.verified ? 'Verified' : 'Pending' }}
                </mat-chip>
              </div>
              }
            </div>
            } @else {
            <div class="empty-state">
              <mat-icon>business</mat-icon>
              <p>No recent organisations</p>
            </div>
            }
          </mat-card-content>
        </mat-card>

        <mat-card class="system-health-card">
          <mat-card-header>
            <mat-card-title>System Health</mat-card-title>
          </mat-card-header>
          <mat-card-content>
            <div class="health-metrics">
              <div class="health-item">
                <div class="health-label">API Status</div>
                <mat-chip color="primary">Operational</mat-chip>
              </div>
              <div class="health-item">
                <div class="health-label">Database</div>
                <mat-chip color="primary">Healthy</mat-chip>
              </div>
              <div class="health-item">
                <div class="health-label">Storage</div>
                <mat-chip color="primary">Available</mat-chip>
              </div>
              <div class="health-item">
                <div class="health-label">Notifications</div>
                <mat-chip color="primary">Active</mat-chip>
              </div>
            </div>
          </mat-card-content>
        </mat-card>
      </div>
    </div>
  `,
  styles: [
    `
      .dashboard-container {
        padding: 24px;
        max-width: 1600px;
        margin: 0 auto;
      }

      .dashboard-header {
        margin-bottom: 32px;

        h1 {
          font-size: 2rem;
          margin-bottom: 8px;
          color: #212121;
        }

        p {
          color: #616161;
          margin: 0;
        }
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
      }

      .stat-card {
        mat-card-content {
          display: flex;
          align-items: center;
          gap: 16px;
          padding: 24px !important;
        }

        &.primary .stat-icon {
          background-color: #e3f2fd;
          color: #2196f3;
        }
        &.success .stat-icon {
          background-color: #e8f5e9;
          color: #4caf50;
        }
        &.warning .stat-icon {
          background-color: #fff3e0;
          color: #ff9800;
        }
        &.info .stat-icon {
          background-color: #e1f5fe;
          color: #00bcd4;
        }
      }

      .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;

        mat-icon {
          font-size: 28px;
          width: 28px;
          height: 28px;
        }
      }

      .stat-details {
        flex: 1;
      }

      .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #212121;
        line-height: 1;
        margin-bottom: 8px;
      }

      .stat-label {
        color: #616161;
        font-size: 0.875rem;
      }

      .quick-actions-card {
        margin-bottom: 32px;
      }

      .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;

        button {
          display: flex;
          align-items: center;
          gap: 8px;
          justify-content: center;
          padding: 12px 24px !important;
        }
      }

      .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
      }

      .activity-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .activity-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px;
        border-radius: 8px;
        background-color: #fafafa;
      }

      .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background-color: #e3f2fd;
        display: flex;
        align-items: center;
        justify-content: center;

        mat-icon {
          color: #2196f3;
          font-size: 20px;
          width: 20px;
          height: 20px;
        }
      }

      .activity-details {
        flex: 1;
      }

      .activity-title {
        font-weight: 500;
        color: #212121;
        margin-bottom: 4px;
      }

      .activity-subtitle {
        font-size: 0.875rem;
        color: #616161;
      }

      .health-metrics {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .health-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background-color: #fafafa;
      }

      .health-label {
        font-weight: 500;
        color: #212121;
      }

      .empty-state {
        text-align: center;
        padding: 48px 24px;
        color: #9e9e9e;

        mat-icon {
          font-size: 64px;
          width: 64px;
          height: 64px;
          margin-bottom: 16px;
          opacity: 0.5;
        }

        p {
          margin: 0;
          font-size: 1rem;
        }
      }

      @media (max-width: 768px) {
        .stats-grid,
        .dashboard-grid {
          grid-template-columns: 1fr;
        }

        .actions-grid {
          grid-template-columns: 1fr;
        }
      }
    `,
  ],
})
export class AdminDashboardComponent implements OnInit {
  protected router = inject(Router);
  protected ROUTES = ROUTES;

  // Signals for reactive state
  protected stats = signal<Partial<AdminDashboardResponse>>({
    totalOrganisations: 0,
    totalUsers: 0,
    activeInterviews: 0,
    verifiedOrganisations: 0,
  });

  protected recentOrganisations = signal<any[]>([]);

  ngOnInit(): void {
    this.loadDashboardData();
  }

  /**
   * Load dashboard statistics and data
   */
  private loadDashboardData(): void {
    // TODO: Replace with actual API calls
    this.stats.set({
      totalOrganisations: 45,
      totalUsers: 1250,
      activeInterviews: 89,
      verifiedOrganisations: 38,
    });

    this.recentOrganisations.set([
      {
        id: '1',
        name: 'Tech Corp Solutions',
        email: 'admin@techcorp.com',
        verified: true,
      },
      {
        id: '2',
        name: 'Innovation Labs',
        email: 'contact@innovationlabs.com',
        verified: false,
      },
      {
        id: '3',
        name: 'Digital Ventures',
        email: 'info@digitalventures.com',
        verified: true,
      },
    ]);
  }

  /**
   * Navigate to specified route
   */
  protected navigateTo(route: string): void {
    this.router.navigate([route]);
  }
}
